<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>graph_based_slam</name>
  <version>0.1.0</version>
  <description>Graph-based SLAM backend with g2o pose graph optimization for multi-depth 3D SLAM</description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_eigen</depend>
  <depend>pcl_conversions</depend>
  <depend>slam_msgs</depend>
  <depend>ndt_omp_ros2</depend>

  <build_depend>libpcl-all-dev</build_depend>
  <build_depend>libg2o-dev</build_depend>
  <exec_depend>libpcl-all</exec_depend>
  <exec_depend>libg2o-dev</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
