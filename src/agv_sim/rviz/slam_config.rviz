Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /SLAM Map1
        - /Trajectory1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz_common/Views
    Help Height: 78
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    # === GRID ===
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>

    # === ROBOT MODEL ===
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true

    # === TF FRAMES ===
    - Class: rviz_default_plugins/TF
      Enabled: true
      Marker Scale: 0.3
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0.1
      Frames:
        All Enabled: false
        map:
          Value: true
        odom:
          Value: true
        base_link:
          Value: true
        base_footprint:
          Value: true

    # ==========================================
    # SLAM MAP - Point Cloud hasil OctoMap (HIJAU)
    # ==========================================
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 0; 255; 100
      Color Transformer: FlatColor
      Enabled: true
      Name: SLAM Map
      Size (Pixels): 3
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /slam/map_cloud
      Use Fixed Frame: true

    # ==========================================
    # CURRENT SCAN - Scan saat ini (KUNING)
    # ==========================================
    - Alpha: 0.8
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 0
      Color Transformer: FlatColor
      Enabled: true
      Name: Current Scan
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /slam/current_scan
      Use Fixed Frame: true

    # ==========================================
    # TRAJECTORY - Jalur robot (MERAH)
    # ==========================================
    - Class: rviz_default_plugins/Path
      Color: 255; 50; 50
      Enabled: true
      Name: Trajectory
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /slam/trajectory
      Line Style:
        Line Width: 0.03
        Value: Lines

    # ==========================================
    # SLAM POSE - Posisi robot dari SLAM (BIRU)
    # ==========================================
    - Class: rviz_default_plugins/Pose
      Color: 0; 100; 255
      Enabled: true
      Name: SLAM Pose
      Head Length: 0.1
      Head Width: 0.07
      Shaft Length: 0.2
      Shaft Width: 0.03
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /slam/pose

    # ==========================================
    # OCCUPANCY GRID - 2D map dari pointcloud_to_grid
    # ==========================================
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Height Grid
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /height_grid

    # ==========================================
    # MERGED CLOUD - Gabungan 4 kamera (CYAN)
    # ==========================================
    - Alpha: 0.6
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 0; 200; 255
      Color Transformer: FlatColor
      Enabled: false
      Name: Merged Cloud (Debug)
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /full_pointcloud
      Use Fixed Frame: true

    # ==========================================
    # RAW CAMERAS - Bisa di-toggle untuk debug
    # ==========================================
    - Alpha: 0.6
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: AxisColor
      Enabled: false
      Name: Cam1_Depan (Raw)
      Size (Pixels): 1
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cloud_in1/points
    - Alpha: 0.6
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: AxisColor
      Enabled: false
      Name: Cam2_Belakang (Raw)
      Size (Pixels): 1
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cloud_in2/points
    - Alpha: 0.6
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: AxisColor
      Enabled: false
      Name: Cam3_Kiri (Raw)
      Size (Pixels): 1
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cloud_in3/points
    - Alpha: 0.6
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: AxisColor
      Enabled: false
      Name: Cam4_Kanan (Raw)
      Size (Pixels): 1
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Best Effort
        Value: /cloud_in4/points

  Global Options:
    Background Color: 33; 33; 33
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15.0
      Enable Focus: true
      Name: Current View
      Pitch: 0.6
      Target Frame: base_link
      Yaw: 0.785
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Height: 900
  Width: 1400
  X: 50
  Y: 50
